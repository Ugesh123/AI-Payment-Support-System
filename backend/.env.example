# Required: any long random string (at least 16 characters)
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Leave empty to run with an in-memory store (no database needed)
DATABASE_URL=mysql://root:password@localhost:3306/payment_support_db

PORT=8080
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,https://ai-payment-support-system.vercel.app

# Optional: create/promote an admin on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
